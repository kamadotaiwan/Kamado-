-- Tìm Sound trên Boombox hoặc tạo Sound dự phòng
local function getTargetSound()
	local char = player.Character
	local backpack = player:FindFirstChild("Backpack")

	local containers = {}
	if char then
		table.insert(containers, char)
	end
	if backpack then
		table.insert(containers, backpack)
	end

	for _, container in ipairs(containers) do
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and string.find(string.lower(item.Name), "boombox") then
				local existingSound = item:FindFirstChildWhichIsA("Sound", true)
				if existingSound then
					return existingSound, item
				end
				local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart", true)
				if handle then
					local newSound = Instance.new("Sound")
					newSound.Name = SCRIPT_NAME .. "_Sound"
					newSound.Looped = true
					newSound.Volume = 1
					newSound.Parent = handle
					return newSound, item
				end
			end
		end
	end

	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	if rootPart then
		local fallback = rootPart:FindFirstChild(SCRIPT_NAME .. "_FallbackSound")
		if not fallback then
			fallback = Instance.new("Sound")
			fallback.Name = SCRIPT_NAME .. "_FallbackSound"
			fallback.Looped = true
			fallback.Volume = 1
			fallback.Parent = rootPart
		end
		return fallback, nil
	end

	return nil, nil
end

local function normalizeSoundId(rawText)
	local digits = string.match(rawText or "", "%d+")
	if not digits then
		return nil
	end
	return "rbxassetid://" .. digits
end

playBtn.MouseButton1Click:Connect(function()
	local formattedId = normalizeSoundId(idBox.Text)
	if not formattedId then
		statusLabel.Text = "Trạng thái: ID nhạc không hợp lệ!"
		statusLabel.TextColor3 = Color3.fromRGB(255, 110, 110)
		return
	end

	local soundObj, boomboxTool = getTargetSound()
	if not soundObj then
		statusLabel.Text = "Trạng thái: Không tìm thấy đối tượng phát âm thanh."
		statusLabel.TextColor3 = Color3.fromRGB(255, 110, 110)
		return
	end

	if boomboxTool then
		for _, desc in ipairs(boomboxTool:GetDescendants()) do
			if desc:IsA("RemoteEvent") then
				pcall(function()
					desc:FireServer(formattedId)
				end)
			end
		end
	end

	soundObj.SoundId = formattedId
	soundObj.TimePosition = 0
	soundObj.Looped = true
	soundObj:Play()

	statusLabel.Text = "Đang phát: " .. formattedId
	statusLabel.TextColor3 = Color3.fromRGB(110, 235, 160)
end)

stopBtn.MouseButton1Click:Connect(function()
	local soundObj = getTargetSound()
	if soundObj then
		soundObj:Stop()
	end
	statusLabel.Text = "Trạng thái: Đã dừng nhạc."
	statusLabel.TextColor3 = Color3.fromRGB(220, 200, 110)
end)

