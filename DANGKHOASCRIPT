-- Vòng lặp chính
RunService.RenderStepped:Connect(function()
	local mousePos = UserInputService:GetMouseLocation()
	ui.FovCircle.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
	ui.FovCircle.Visible = state.Aimlock and state.ShowFOV

	if state.Aimlock then
		local target = getClosestTargetInFOV()
		if target then
			camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
		end
	end

	if state.WalkSpeedEnabled then applyWalkSpeed() end
	if state.JumpPowerEnabled then applyJumpPower() end
	if state.NoclipEnabled then applyNoclip() end

	if state.FlyEnabled and bodyVelocity and bodyGyro then
		local char = localPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum then
			local moveDir = hum.MoveDirection
			local vertical = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical += 1 end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical -= 1 end

			local camLook = camera.CFrame.LookVector
			local flyVec = Vector3.zero
			if moveDir.Magnitude > 0 then
				flyVec += (camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, -moveDir.Z)).Unit * state.FlySpeed)
			end
			if vertical ~= 0 then
				flyVec += Vector3.new(0, vertical * state.FlySpeed, 0)
			end

			bodyVelocity.Velocity = flyVec
			bodyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + camLook)
		end
	end
end)

