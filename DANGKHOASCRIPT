-- ESP
local function clearESP()
	for _, h in pairs(espObjects) do
		if h and h.Parent then
			h:Destroy()
		end
	end
	table.clear(espObjects)
end

local function applyESP(player, character)
	if player == localPlayer or not character then return end
	if espObjects[player] then
		espObjects[player]:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "DANGKHOAPNG_ESP"
	highlight.FillColor = Color3.fromRGB(255, 60, 60)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.Adornee = character
	highlight.Parent = character

	espObjects[player] = highlight
end

local function setESP(enabled)
	state.ESP = enabled
	clearESP()
	if enabled then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character then
				applyESP(p, p.Character)
			end
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char)
		if state.ESP then
			applyESP(player, char)
		end
	end)
end)

-- X-Ray
local function isCharPart(part)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character and part:IsDescendantOf(p.Character) then
			return true
		end
	end
	return false
end

local function setXRay(enabled)
	state.XRay = enabled
	if enabled then
		table.clear(xraySavedParts)
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not isCharPart(obj) and obj.Transparency < 0.75 then
				xraySavedParts[obj] = obj.LocalTransparencyModifier
				obj.LocalTransparencyModifier = 0.75
			end
		end
	else
		for part, mod in pairs(xraySavedParts) do
			if part and part.Parent then
				part.LocalTransparencyModifier = mod
			end
		end
		table.clear(xraySavedParts)
	end
end

-- Invisible
local function setInvisible(enabled)
	state.Invisible = enabled
	local char = localPlayer.Character
	if not char then return end

	if enabled then
		table.clear(savedTransparencies)
		for _, d in ipairs(char:GetDescendants()) do
			if (d:IsA("BasePart") and d.Name ~= "HumanoidRootPart") or d:IsA("Decal") then
				savedTransparencies[d] = d.Transparency
				d.Transparency = 1
			end
		end
	else
		for inst, orig in pairs(savedTransparencies) do
			if inst and inst.Parent then
				inst.Transparency = orig
			end
		end
		table.clear(savedTransparencies)
	end
end

-- WalkSpeed & JumpPower
local function applyWalkSpeed()
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = state.WalkSpeedEnabled and state.WalkSpeedValue or 16
	end
end

local function applyJumpPower()
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = state.JumpPowerEnabled and state.JumpPowerValue or 50
	end
end

-- Fly
local function stopFly()
	if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
	if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
	end
end

local function startFly()
	stopFly()
	local char = localPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	hum.PlatformStand = true

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "DANGKHOAPNG_FlyVel"
	bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = root

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "DANGKHOAPNG_FlyGyro"
	bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	bodyGyro.P = 1e4
	bodyGyro.CFrame = root.CFrame
	bodyGyro.Parent = root
end

local function setFly(enabled)
	state.FlyEnabled = enabled
	if enabled then
		startFly()
	else
		stopFly()
	end
end

-- Noclip
local function applyNoclip()
	local char = localPlayer.Character
	if not char then return end

	if state.NoclipEnabled then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				if savedCanCollide[p] == nil then
					savedCanCollide[p] = p.CanCollide
				end
				p.CanCollide = false
			end
		end
	else
		for p, orig in pairs(savedCanCollide) do
			if p and p.Parent then
				p.CanCollide = orig
			end
		end
		table.clear(savedCanCollide)
	end
end

-- Aimlock
local function getClosestTargetInFOV()
	local mousePos = UserInputService:GetMouseLocation()
	local closestPart = nil
	local closestDist = state.AimFOV

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local aimPart = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and aimPart then
				local screenPos, onScreen = camera:WorldToViewportPoint(aimPart.Position)
				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if dist <= closestDist then
						closestDist = dist
						closestPart = aimPart
					end
				end
			end
		end
	end

	return closestPart
end

